{
  "version": 2,
  "builds": [
    {
      "src": "kapita/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "kapita/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "kapita.settings"
  },
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "kapita.settings"
    }
  }
}
